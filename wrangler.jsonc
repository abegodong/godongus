{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "godongus",
  "main": "worker.js",
  "compatibility_date": "2026-06-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "CONTACT_TO_EMAIL": "abraham@godong.us",
    "CONTACT_FROM_EMAIL": "hello@godong.us",
    "TURNSTILE_SITE_KEY": "0x4AAAAAADgxzD1o56l4-iSB"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
